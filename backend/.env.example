# Copy this file to `.env` and fill in your values. NEVER commit `.env`.

APP_NAME=Thorkell
DEBUG=true

# --- Providers: free now, swap to paid later by changing these values ---
# transcription: groq | whisper_local
TRANSCRIPTION_PROVIDER=groq
# summarization: groq | none
SUMMARIZATION_PROVIDER=groq
# diarization: manual | assemblyai
DIARIZATION_PROVIDER=manual

# --- Groq (free tier) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Check https://console.groq.com/docs/models for current model IDs.
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# --- Local Whisper fallback (only used when TRANSCRIPTION_PROVIDER=whisper_local) ---
WHISPER_LOCAL_MODEL=base.en
WHISPER_LOCAL_DEVICE=cpu

# --- Storage / database (defaults are fine for local use) ---
# DATABASE_URL=sqlite:///./thorkell.db
# STORAGE_DIR=./storage
